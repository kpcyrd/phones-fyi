{{#*inline "page"}}
<section id="comparison" class="search-filter">
    <div class="filter-grid">
        <div class="filter-group">
            <label for="search">Search</label>
            <input type="text" id="search" placeholder="Device name or codename...">
        </div>
        <div class="filter-group">
            <label for="vendor">Vendor</label>
            <select id="vendor">
                <option value="">All Vendors</option>
                {{#each vendors}}
                <option value="{{@key}}">{{this.name}}</option>
                {{/each}}
            </select>
        </div>
        <div class="filter-group">
            <label for="os">Operating System</label>
            <select id="os">
                <option value="">Any</option>
                <option value="android">Android</option>
                <option value="ios">iOS</option>
            </select>
        </div>
        <div class="filter-group">
            <label for="security">Security Level</label>
            <select id="security">
                <option value="">Any</option>
                <option value="bfu">Secure "Before First Unlock"</option>
                <option value="afu">Secure "After First Unlock"</option>
            </select>
        </div>
    </div>
</section>

<section class="comparison-table">
    <table>
        <thead>
            <tr>
                <th>Device</th>
                <th><span class="tooltip" data-tooltip="Still receiving security updates">Security Support</span></th>
                <th><span class="tooltip" data-tooltip="Verified Boot ensures system integrity">Secure Boot</span></th>
                <th><span class="tooltip" data-tooltip="Hardware-backed keystore">Hardware Keystore</span></th>
                <th><span class="tooltip" data-tooltip="Before first unlock">BFU Secure</span></th>
                <th><span class="tooltip" data-tooltip="After first unlock">AFU Secure</span></th>
            </tr>
        </thead>
        <tbody>
            {{#each devices}}
            <tr data-vendor="{{this.vendor_id}}" data-security="{{#if (eq this.afu_secure.class "yes")}}afu{{else if (eq this.bfu_secure.class "yes")}}bfu{{/if}}">
                <td>
                    <div class="device-info">
                        <div>
                            <div class="device-name">
                                <a href="devices/{{this.codename}}/">{{lookup (lookup ../vendors this.vendor_id) "name" }} {{this.name}}</a>
                            </div>
                            <div class="device-codename" title="{{this.release_date}}">{{this.codename}}</div>
                        </div>
                    </div>
                </td>
                {{#if this.security_support}}
                <td><span class="badge badge-yes">✓ Yes</span></td>
                {{else}}
                <td><span class="badge badge-no">✗ No</span></td>
                {{/if}}
                <td>{{> status.html.hbs status=this.secure_boot }}</td>
                <td>{{> status.html.hbs status=this.hardware_keystore }}</td>
                <td>{{> status.html.hbs status=this.bfu_secure }}</td>
                <td>{{> status.html.hbs status=this.afu_secure }}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>

<section id="about" class="info-section">
    <h2>Understanding Hardware Security</h2>
    <div class="info-grid">
        <div class="info-card">
            <h3>📦 Security Support</h3>
            <p>Indicates whether the device is still receiving security updates from the manufacturer, which is crucial
                for protecting against known vulnerabilities.</p>
        </div>
        <div class="info-card">
            <h3>🔐 Secure Boot</h3>
            <p>Verified Boot ensures that all executed code comes from a trusted source and hasn't been tampered with.
                It establishes a chain of trust from the bootloader through the kernel to the system.</p>
        </div>
        <div class="info-card">
            <h3>🔑 Hardware Keystore (Anti Chip-Off)</h3>
            <p>Hardware-backed keystores store cryptographic keys in dedicated secure hardware, making them resistant to
                extraction even if the device is partially compromised.</p>
        </div>
        <div class="info-card">
            <h3>🛠️ Chip-off attacks</h3>
            <p>Chip-off attacks involve physically removing the memory chip from a device to extract data directly. This
                method bypasses many software-based security measures.</p>
        </div>
        <div class="info-card">
            <h3>🔓️ Hardware exploits</h3>
            <p>Hardware exploits target unpatchable vulnerabilities in the hardware to gain unauthorized access or
                control over the device.</p>
        </div>
        <div class="info-card">
            <h3>💾 No software exploits</h3>
            <p>This overview is explicitly excluding software-based vulnerabilities (local root) and focuses solely on
                hardware-level security aspects.</p>
        </div>
        <div class="info-card">
            <h3>⏪️ Before first unlock (BFU)</h3>
            <p>This refers to the security state of the device before the user has unlocked it for the first time after
                a reboot, when certain security features may be more restrictive.</p>
        </div>
        <div class="info-card">
            <h3>⏩️ After first unlock (AFU)</h3>
            <p>This refers to the security state of the device after the user has unlocked it for the first time
                following a reboot, when some security features may be less restrictive.</p>
        </div>
        <div class="info-card">
            <h3>⚖️ Licensing</h3>
            <p>This site uses data from
<a href="https://github.com/LineageOS/lineage_wiki" target="_blank">LineageOS Wiki</a>,
<a href="https://endoflife.date/xyz" target="_blank">endoflife.date</a>, and
<a href="https://grapheneos.org/faq" target="_blank">GrapheneOS FAQ</a>.
The data comes from open sources and is used under their respective licenses, including
<a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank"><code>CC-BY-SA 3.0</code></a>,
which is also the license for content on this site.
                </p>
        </div>
    </div>
</section>
{{/inline}}
{{#*inline "script"}}
<script>
    document.getElementById('search').addEventListener('input', filterTable);
    document.getElementById('vendor').addEventListener('change', filterTable);
    document.getElementById('os').addEventListener('change', filterTable);
    document.getElementById('security').addEventListener('change', filterTable);

    function filterTable() {
        const searchTerm = document.getElementById('search').value.toLowerCase();
        const vendorFilter = document.getElementById('vendor').value;
        const osFilter = document.getElementById('os').value;
        const securityFilter = document.getElementById('security').value;
        const rows = document.querySelectorAll('tbody tr');

        rows.forEach(row => {
            const deviceName = row.querySelector('.device-name').textContent.toLowerCase();
            const deviceCodename = row.querySelector('.device-codename').textContent.toLowerCase();
            const vendor = row.dataset.vendor;
            const isAndroid = vendor != 'apple';

            const matchesSearch = deviceName.includes(searchTerm) || deviceCodename.includes(searchTerm);
            const matchesVendor = !vendorFilter || vendor == vendorFilter;
            const matchesOs = !osFilter || (osFilter == 'android' && isAndroid) || (osFilter === 'ios' && !isAndroid);
            const matchesSecurity = !securityFilter || row.dataset.security == securityFilter;

            row.hidden = !(matchesSearch && matchesVendor && matchesOs && matchesSecurity);
        });
    }
    filterTable();

    // Smooth scroll for anchor links
    ['#', '/#'].forEach(prefix => {
        document.querySelectorAll(`a[href^="${prefix}"]`).forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const href = this.getAttribute('href').replace(/^\//, '');
                const target = document.querySelector(href);
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    });

    document.addEventListener('DOMContentLoaded', function () {
        const height = Math.ceil(window.scrollY + document.querySelector('main').getBoundingClientRect().top);
        document.documentElement.style.scrollPaddingTop = `${height}px`;
    });
</script>
{{/inline}}
{{> base.html.hbs }}
