{{#if status}}
<span class="badge badge-{{status.class}}">
    {{#if status.reference }}
    <a href="{{status.reference}}" target="_blank" rel="noopener noreferrer">
    {{/if}}
    {{#if (eq status.class "yes")}}
    ✓
    {{else if (eq status.class "no")}}
    ✗
    {{else}}
    ⚠
    {{/if}}
    {{status.conclusion }}
    {{#if status.reference }}
    </a>
    {{/if}}
    </span>
{{else}}
<span class="badge badge-partial">⚠ Unknown</span>
{{/if}}
